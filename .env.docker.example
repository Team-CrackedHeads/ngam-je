# ============================================================================
# DOCKER COMPOSE ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains environment variables for Docker Compose services
# (PostgreSQL, pgAdmin, etc.)
#
# Copy this file to .env for docker-compose to use:
#   cp .env.docker.example .env
#
# For application-specific configurations:
# - Backend: See backend/.env.backend.example
# - Frontend: See frontend/.env.frontend.example
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
POSTGRES_USER=ngamje
POSTGRES_PASSWORD=ngamje_dev_password
POSTGRES_DB=ngamje_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================================================
# PGADMIN CONFIGURATION
# ============================================================================
# Web interface for PostgreSQL management
# Access at: http://localhost:5050
PGADMIN_EMAIL=admin@ngamje.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ============================================================================
# BACKEND DATABASE CONNECTION
# ============================================================================
# Used by backend service when running via Docker Compose
DATABASE_URL=postgresql://ngamje:ngamje_dev_password@localhost:5432/ngamje_db
ENV=development
DEBUG=true

# ============================================================================
# GCP CONFIGURATION (PRODUCTION ONLY)
# ============================================================================
# Only required when deploying to Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
USE_SECRET_MANAGER=false

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# LEGACY SECURITY CONFIGURATION
# ============================================================================
# Note: These are legacy settings. The app now uses Clerk for authentication.
# Kept for backward compatibility.
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# STRIPE CONFIGURATION (OPTIONAL)
# ============================================================================
# Only needed if payment features are enabled
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
