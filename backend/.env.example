# ============================================================================
# BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit .env files to version control
# ============================================================================

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENV=development
DEBUG=true

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
POSTGRES_USER=ngamje
POSTGRES_PASSWORD=ngamje_dev_password
POSTGRES_DB=ngamje_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# CLERK AUTHENTICATION
# ============================================================================
# Get these from: https://dashboard.clerk.com/
# Your Clerk Dashboard → API Keys
#
# IMPORTANT: Keep both keys on the backend:
# - CLERK_PUBLISHABLE_KEY: Used for SDK initialization
# - CLERK_SECRET_KEY: Used for JWT verification (NEVER share publicly)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_FRONTEND_API=https://your-app.clerk.accounts.dev

# ============================================================================
# DIDIT KYC VERIFICATION
# ============================================================================
# Get these from: https://business.didit.me → API & Webhooks
# Required for identity verification features
DIDIT_API_KEY=your_didit_api_key_here
DIDIT_WEBHOOK_SECRET=your_didit_webhook_secret_here
DIDIT_WORKFLOW_ID=your_kyc_workflow_id_here
DIDIT_BASE_URL=https://verification.didit.me

# Webhook Callback URL (must be publicly accessible)
# Development: Use ngrok or similar tunneling service
#   Example: https://abc123.ngrok-free.app/api/v1/kyc/webhook
# Production: Use your actual API domain
#   Example: https://api.yourdomain.com/api/v1/kyc/webhook
DIDIT_CALLBACK_URL=https://your-ngrok-url.ngrok-free.app/api/v1/kyc/webhook

# ============================================================================
# TEMPORARY: KYC BYPASS MODE FOR DEVELOPMENT
# TODO: Remove this section before production deployment
# ============================================================================
# Set to true to skip real KYC verification calls (for local development)
# When enabled:
# - No real API calls are made to Didit
# - Mock session data is returned
# - Use POST /api/v1/kyc/dev/approve to manually approve KYC for testing
KYC_SKIP_VERIFICATION=false
# ============================================================================

# ============================================================================
# GCP CONFIGURATION (OPTIONAL)
# ============================================================================
# Only required if deploying to Google Cloud Platform
GCP_PROJECT_ID=
GCP_REGION=us-central1
USE_SECRET_MANAGER=false
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================================================
# STRIPE CONFIGURATION (OPTIONAL)
# ============================================================================
# Get these from: https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) for development
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ============================================================================
# AI SERVICES CONFIGURATION
# ============================================================================
# Google Gemini API (Required for AI features: image generation, enhancement, listing generation)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# SerpAPI (Required for price intelligence)
# Get from: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# Unsplash API (Required for image search/backgrounds)
# Get from: https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
