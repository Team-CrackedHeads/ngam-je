# ============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env.local and update with your actual values
# NEVER commit .env.local files to version control
#
# IMPORTANT: Only use NEXT_PUBLIC_ prefix for variables that are safe to
# expose in the browser. NEVER put secret keys in the frontend.
# ============================================================================

# ============================================================================
# BACKEND API CONFIGURATION
# ============================================================================
# Point this to your FastAPI backend server
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================================
# CLERK AUTHENTICATION
# ============================================================================
# Get these from: https://dashboard.clerk.com/
# Your Clerk Dashboard → API Keys
#
# IMPORTANT: Only use the PUBLISHABLE key in frontend (safe for browser)
# The SECRET key should ONLY be in backend/.env (never in frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# ============================================================================
# GOOGLE MAPS API CONFIGURATION
# ============================================================================
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Required APIs to enable:
# - Maps JavaScript API
# - Geocoding API
# - Places API (if using autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================================================
# STRIPE CONFIGURATION
# ============================================================================
# Get your API keys from: https://dashboard.stripe.com/apikeys
# Use test keys (pk_test_...) for development
#
# IMPORTANT: Only use PUBLISHABLE key in frontend
# The SECRET key (sk_test_...) should ONLY be in backend/.env
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ============================================================================
# FIREBASE CONFIGURATION (OPTIONAL)
# ============================================================================
# Get these from: https://console.firebase.google.com/
# Project Settings → General → Your apps → SDK setup and configuration
#
# Note: These are public identifiers, safe to expose in browser
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id
