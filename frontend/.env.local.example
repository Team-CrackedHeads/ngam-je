# Google Maps API Configuration
# Get your API key from https://console.cloud.google.com/google/maps-apis
# Required APIs: Maps JavaScript API, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# BetterAuth Configuration
# Database connection string for PostgreSQL
# Local development: postgresql://user:password@localhost:5432/dbname
# GCP Cloud SQL: postgresql://user:password@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://ngamje:ngamje_dev_password@localhost:5432/ngamje_db

# Auth secret for JWT signing (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your_32_char_secret_key_here_replace_me

# App URL (for callbacks and redirects)
BETTER_AUTH_URL=http://localhost:3000
